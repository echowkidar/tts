# ==============================================================================
# Voice Studio by Echowkidar — Environment Configuration File (.env.example)
# Copy this file to `.env` or set these variables in Portainer / Docker Compose
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & PORT CONFIGURATION (Portainer & Docker Compose)
# ------------------------------------------------------------------------------
# Port for Vite Frontend UI (Default: 7865)
PORT=7865

# Port for FastAPI Backend (Default: 8885)
BACKEND_PORT=8885

# Bind Host (Default: 0.0.0.0 for Docker container)
HOST=0.0.0.0
VITE_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# JWT Secret Key for user sessions (Change this to a strong random string in production!)
JWT_SECRET_KEY=echowkidar_super_secret_jwt_key_987654321_change_me

# JWT Token Expiry in Days (Default: 30 days)
ACCESS_TOKEN_EXPIRE_DAYS=30

# Google OAuth Client ID (Get from Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 3. UPI QR CODE PAYMENT CONFIGURATION (India - INR ₹)
# ------------------------------------------------------------------------------
# Your UPI ID for receiving payments via GPay, PhonePe, Paytm, BHIM UPI
UPI_ID=echowkidar@upi

# Name displayed on the UPI QR Code scanner screen
UPI_NAME=Zafar Ali Khan (Voice Studio)

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite Async Database URL (Default: sqlite+aiosqlite:///backend/database.db)
DATABASE_URL=sqlite+aiosqlite:///app/backend/database.db

# ------------------------------------------------------------------------------
# 5. HARDWARE & TTS ENGINE SETTINGS
# ------------------------------------------------------------------------------
# Inference Device: "auto" (picks CUDA > MPS > CPU), "cuda", "cpu", or "mps"
DEVICE=auto

# Default TTS Model ID
MODEL_ID=microsoft/VibeVoice-1.5B

# Max Text Characters per request (Global hard limit)
MAX_TEXT_CHARS=5000

# Synthesis Timeout in Seconds
SYNTH_TIMEOUT_S=600

# Default Generation CFG Scale
DEFAULT_CFG_SCALE=1.3

# Log Level: info, debug, warning, error
LOG_LEVEL=info
