# VibeVoice & Auth Backend Configuration
# Copy to `.env` or set in Portainer Stack Environment Variables.

# Server & Ports
HOST=0.0.0.0
PORT=8885

# Auth & Security
JWT_SECRET_KEY=echowkidar_super_secret_jwt_key_987654321_change_me
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# UPI QR Code Payments
UPI_ID=echowkidar@upi
UPI_NAME=Zafar Ali Khan (Voice Studio)

# Database
DATABASE_URL=sqlite+aiosqlite:///backend/database.db

# Model & Hardware
MODEL_ID=microsoft/VibeVoice-1.5B
DEVICE=auto

# Filesystem
VOICES_DIR=./voices
UPLOADS_DIR=./uploads
CACHE_DIR=./cache
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=500

# Limits
MAX_TEXT_CHARS=5000
SYNTH_TIMEOUT_S=600
DEFAULT_CFG_SCALE=1.3
LOG_LEVEL=info
